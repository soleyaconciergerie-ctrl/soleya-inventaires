<script>
const etapes=[...document.querySelectorAll('.etape')];
const fil=document.getElementById('fil');
let i=0;

etapes.forEach((s,n)=>{
  const b=document.createElement('button');
  b.textContent=s.dataset.titre;
  b.onclick=()=>montrer(n);
  fil.appendChild(b);
});

function montrer(n){
  i=Math.max(0,Math.min(etapes.length-1,n));
  etapes.forEach((s,k)=>s.classList.toggle('actif',k===i));
  [...fil.children].forEach((b,k)=>b.setAttribute('aria-current',k===i));
  window.scrollTo({top:0,behavior:'smooth'});
}
function aller(d){montrer(i+d)}
montrer(0);

// Signature
const c=document.getElementById('sign');
const ctx=c.getContext('2d');
function taille(){
  const r=c.getBoundingClientRect();
  c.width=r.width*2;c.height=r.height*2;
  ctx.scale(2,2);ctx.lineWidth=2;ctx.lineCap='round';ctx.strokeStyle='#12312c';
}
taille();window.addEventListener('resize',taille);
let trace=false;
function pos(e){
  const r=c.getBoundingClientRect();
  const p=e.touches?e.touches[0]:e;
  return{x:p.clientX-r.left,y:p.clientY-r.top};
}
function debut(e){trace=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault()}
function bouge(e){if(!trace)return;const p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();e.preventDefault()}
function fin(){trace=false}
c.addEventListener('mousedown',debut);c.addEventListener('mousemove',bouge);
c.addEventListener('mouseup',fin);c.addEventListener('mouseleave',fin);
c.addEventListener('touchstart',debut);c.addEventListener('touchmove',bouge);
c.addEventListener('touchend',fin);
function effacer(){ctx.clearRect(0,0,c.width,c.height)}
</script>
